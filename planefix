static void SaveRest(RwFrame* f, RestMat& out) {
    if (!f || out.valid)
        return;
    RwMatrix* m = RwFrameGetMatrix(f);
    if (!m)
        return;
    out.right = m->right;
    out.up = m->up;
    out.at = m->at;
    out.pos = m->pos;
    out.valid = true;
}

static RwV3d RotateAroundAxis(const RwV3d& v, const RwV3d& a, float c, float s) {
    const float dot = a.x * v.x + a.y * v.y + a.z * v.z;
    const RwV3d cr = {
        a.y * v.z - a.z * v.y,
        a.z * v.x - a.x * v.z,
        a.x * v.y - a.y * v.x
    };
    const float k = dot * (1.0f - c);
    return {
        v.x * c + cr.x * s + a.x * k,
        v.y * c + cr.y * s + a.y * k,
        v.z * c + cr.z * s + a.z * k
    };
}

static void CopyOrientDelta(RwFrame* src, const RestMat& srcRest,
    RwFrame* dst, const RestMat& dstRest, const RwV3d& hingeEnd,
    float sign = 1.0f, float scale = 1.0f) {
    if (!src || !dst || !srcRest.valid || !dstRest.valid)
        return;
    RwMatrix* sm = RwFrameGetMatrix(src);
    RwMatrix* dm = RwFrameGetMatrix(dst);
    if (!sm || !dm)
        return;

    const RwV3d u = sm->up;
    const float dUpY = srcRest.up.x * u.x + srcRest.up.y * u.y + srcRest.up.z * u.z;
    const float dUpZ = srcRest.at.x * u.x + srcRest.at.y * u.y + srcRest.at.z * u.z;
    const float angle = atan2f(dUpZ, dUpY) * sign * scale;
    const float c = cosf(angle);
    const float s = sinf(angle);

    RwV3d axis = {
        hingeEnd.x - dstRest.pos.x,
        hingeEnd.y - dstRest.pos.y,
        hingeEnd.z - dstRest.pos.z
    };
    float len = sqrtf(axis.x * axis.x + axis.y * axis.y + axis.z * axis.z);
    if (len < 1e-5f) {
        axis = dstRest.right;
        len = sqrtf(axis.x * axis.x + axis.y * axis.y + axis.z * axis.z);
        if (len < 1e-5f)
            return;
    }
    axis.x /= len; axis.y /= len; axis.z /= len;

    if (axis.x * srcRest.right.x + axis.y * srcRest.right.y + axis.z * srcRest.right.z < 0.0f) {
        axis.x = -axis.x; axis.y = -axis.y; axis.z = -axis.z;
    }

    dm->right = RotateAroundAxis(dstRest.right, axis, c, s);
    dm->up = RotateAroundAxis(dstRest.up, axis, c, s);
    dm->at = RotateAroundAxis(dstRest.at, axis, c, s);
    dm->pos = dstRest.pos;
    RwMatrixUpdate(dm);
    RwFrameUpdateObjects(dst);
}

