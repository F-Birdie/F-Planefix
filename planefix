struct Marker { uint8_t r, g, b; };
static const Marker kMarkers[4] = { {255,175,0}, {0,255,200}, {185,255,0}, {255,60,0} };
static const char* kIgnoreFramePrefixes[] = { nullptr };

struct LampMat {
    RpMaterial* mat;
    RwTexture* original;
    int         lamp;
};
struct ModelCache {
    RpClump* templ = nullptr;
    std::vector<LampMat> mats;
};
static std::unordered_map<int, ModelCache> g_cache;
static std::unordered_map<CVehicle*, int>  g_seen;
static std::unordered_map<int, int>        g_liveCount;

static void ReleaseModel(int model) {
    auto it = g_cache.find(model);
    if (it == g_cache.end())
        return;
    for (const LampMat& l : it->second.mats) {
        if (l.mat && RpMaterialGetTexture(l.mat) != l.original)
            RpMaterialSetTexture(l.mat, l.original);
    }
    g_cache.erase(it);
}

static int MarkerIndex(const RwRGBA* c) {
    if (!c)
        return -1;
    for (int i = 0; i < 4; i++) {
        if (c->red == kMarkers[i].r && c->green == kMarkers[i].g && c->blue == kMarkers[i].b)
            return i;
    }
    return -1;
}

static RpMaterial* CollectMaterial(RpMaterial* m, void* data) {
    if (!m)
        return m;
    RwTexture* tex = RpMaterialGetTexture(m);
    if (!tex)
        return m;
    const char* tname = RwTextureGetName(tex);
    if (!tname || _strnicmp(tname, "vehiclelights", 13) != 0)
        return m;
    const int lamp = MarkerIndex(RpMaterialGetColor(m));
    if (lamp < 0)
        return m;
    static_cast<std::vector<LampMat>*>(data)->push_back({ m, tex, lamp });
    return m;
}

static RpAtomic* CollectAtomic(RpAtomic* a, void* data) {
    if (!a)
        return a;
    RwFrame* frame = RpAtomicGetFrame(a);
    if (frame) {
        if (const char* name = GetFrameNodeName(frame)) {
            for (const char* prefix : kIgnoreFramePrefixes) {
                if (prefix && _strnicmp(name, prefix, std::strlen(prefix)) == 0)
                    return a;
            }
        }
    }
    if (RpGeometry* g = RpAtomicGetGeometry(a))
        RpGeometryForAllMaterials(g, CollectMaterial, data);
    return a;
}

static void UpdateLampTextures(CPlane* self) {
    if (!self)
        return;
    CBaseModelInfo* mi = CModelInfo::GetModelInfo(self->m_nModelIndex);
    if (!mi || !mi->m_pRwObject)
        return;

    if (g_seen.emplace(self, static_cast<int>(self->m_nModelIndex)).second)
        ++g_liveCount[self->m_nModelIndex];

    ModelCache& c = g_cache[self->m_nModelIndex];
    RpClump* templ = reinterpret_cast<RpClump*>(mi->m_pRwObject);
    if (c.templ != templ) {
        c.templ = templ;
        c.mats.clear();
        if (templ)
            RpClumpForAllAtomics(templ, CollectAtomic, &c.mats);
    }
    if (c.mats.empty() || !CVehicleModelInfo::ms_pLightsTexture || !CVehicleModelInfo::ms_lightsOn)
        return;

    reinterpret_cast<SetupLightFlagsFn>(SETUP_LIGHT_FLAGS)(self);

    for (const LampMat& l : c.mats) {
        if (!l.mat || !l.original || l.lamp < 0 || l.lamp > 3)
            continue;
        const bool on = CVehicleModelInfo::ms_lightsOn[l.lamp] != 0;
        RwTexture* want = on ? CVehicleModelInfo::ms_pLightsTexture : l.original;
        if (RpMaterialGetTexture(l.mat) != want)
            RpMaterialSetTexture(l.mat, want);
    }
}

static bool IsZeroDummy(const CVector& v) {
    return v.x == 0.0f && v.y == 0.0f && v.z == 0.0f;
}

static void DoPlaneLightsSafe(CPlane* self) {
    if (!self || !self->m_matrix)
        return;
    auto* vmi = static_cast<CVehicleModelInfo*>(CModelInfo::GetModelInfo(self->m_nModelIndex));
    if (!vmi || !vmi->m_pVehicleStruct)
        return;

    CVector& d0 = vmi->m_pVehicleStruct->m_avDummyPos[0];
    CVector& d1 = vmi->m_pVehicleStruct->m_avDummyPos[1];
    const bool z0 = IsZeroDummy(d0);
    const bool z1 = IsZeroDummy(d1);
    if (z0 && z1)
        return;

    const CVector parked = { 0.0f, 0.0f, -1000.0f };
    CVector saved0, saved1;
    if (z0) { saved0 = d0; d0 = parked; }
    if (z1) { saved1 = d1; d1 = parked; }

    reinterpret_cast<LightsFn>(DO_VEHICLE_LIGHTS)(
        self, reinterpret_cast<CMatrix*>(self->m_matrix), LIGHTS_TWIN);

    if (z0) d0 = saved0;
    if (z1) d1 = saved1;
}

