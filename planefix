static bool GetNamedPos(RwFrame* root, const char* name, CVector& out) {
    RwFrame* f = FindFrameByName(root, name);
    if (!f)
        return false;
    RwMatrix* m = RwFrameGetMatrix(f);
    if (!m)
        return false;
    out = { m->pos.x, m->pos.y, m->pos.z };
    return true;
}

static RwV3d DeltaToOffset(const CVector& d) {
    return { d.x, d.z, -d.y };
}

static void UpdateHydraThrusters(CVehicle* veh) {
    if (!veh || veh->m_nModelIndex != MODEL_HYDRA || !veh->m_pRwClump)
        return;
    auto* plane = static_cast<CPlane*>(veh);
    RwFrame* root = RpClumpGetFrame(veh->m_pRwClump);
    if (!root)
        return;

    CVector pivotF, pivotR, thrF, thrR;
    if (!GetNamedPos(root, "wheel_lm_dummy", pivotF))
        return;
    if (!GetNamedPos(root, "wheel_rm_dummy", pivotR))
        return;
    if (!GetNamedPos(root, "thruster_f", thrF))
        return;
    if (!GetNamedPos(root, "thruster_r", thrR))
        return;

    const CVector dF = { thrF.x - pivotF.x, thrF.y - pivotF.y, thrF.z - pivotF.z };
    const CVector dR = { thrR.x - pivotR.x, thrR.y - pivotR.y, thrR.z - pivotR.z };
    const RwV3d offs[4] = {
        DeltaToOffset(dF),
        DeltaToOffset({ -dF.x, dF.y, dF.z }),
        DeltaToOffset(dR),
        DeltaToOffset({ -dR.x, dR.y, dR.z }),
    };
    for (int i = 0; i < 4; i++) {
        FxSystem_c* fx = plane->m_apJettrusParticles[i];
        if (!fx)
            continue;
        RwV3d off = offs[i];
        fx->SetOffsetPos(&off);
    }
}

