constexpr unsigned CPLANE_VMT = 0x871948;
constexpr unsigned FIRE_UNGUIDED = 0x6D5110;
constexpr unsigned FIRE_HEAT_SEEKING = 0x6E05C0;
constexpr unsigned GET_ORDNANCE_POS = 0x6D46E0;
constexpr unsigned GET_ORDNANCE_RATE = 0x6D4590;
constexpr int kOrdnancePrimary = 1;
constexpr int kOrdnanceSecondary = 2;
constexpr int kProjectileRocketHS = 20;

constexpr float kLaunchSec = 0.12f;
constexpr float kLaunchDistance = 0.5f;
constexpr float kRespawnSec = 3.0f;
constexpr float kReloadSec = 0.4f;
constexpr float kReloadDistance = 0.5f;
constexpr float kSpawnOffsetX = 0.0f;
constexpr float kSpawnOffsetY = 0.0f;
constexpr float kSpawnOffsetZ = 0.0f;

static const char* kMissileNames[6] = { "missile1", "missile2", "missile3", "missile4", "missile5", "missile6" };
static const int   kPairs[3][2] = { { 0, 5 }, { 1, 4 }, { 2, 3 } };
static const int   kSingleOrder[6] = { 0, 5, 1, 4, 2, 3 };

using FireUnguidedFn = void(__thiscall*)(CVehicle*, int, bool);
using FireHeatFn = void(__thiscall*)(CVehicle*, CEntity*, int, bool);
using GetOrdnancePosFn = CVector * (__thiscall*)(CVehicle*, CVector*, int);
using RateFn = uint32_t(__thiscall*)(CVehicle*, int);

static FireUnguidedFn   origFireUnguided = reinterpret_cast<FireUnguidedFn>(FIRE_UNGUIDED);
static FireHeatFn       origFireHeat = reinterpret_cast<FireHeatFn>(FIRE_HEAT_SEEKING);
static GetOrdnancePosFn origGetOrdnancePos = reinterpret_cast<GetOrdnancePosFn>(GET_ORDNANCE_POS);

using AtomicList = std::vector<std::pair<RpAtomic*, unsigned>>;
enum MissileMode { MRest, MLaunch, MHidden, MReload };

struct Missile {
    RwFrame* frame = nullptr;
    AtomicList atomics;
    RwMatrix   rest;
    CVector    pos;
    MissileMode mode = MRest;
    float      t = 0.0f;
};

struct MissileState {
    RpClump* clump = nullptr;
    bool     ok = false;
    Missile  m[6];
    int      nextPair = 0;
    int      nextSingle = 0;
    float    sinceShot[3] = { 1000.0f, 1000.0f, 1000.0f };
    bool     pending = false;
    float    pendingLeft = 0.0f;
    int      pendingType = 0;
    CEntity* pendingTarget = nullptr;
    int      shotIdx[2] = { 0, 0 };
    int      shotN = 0;
    bool     firing = false;
};
static std::unordered_map<CVehicle*, MissileState> g_missileStates;

struct MissileFindCtx {
    const char* name;
    RwFrame* found;
};

static RwFrame* MissileFindFrameCB(RwFrame* frame, void* data) {
    auto* ctx = static_cast<MissileFindCtx*>(data);
    const char* n = GetFrameNodeName(frame);
    if (n && _stricmp(n, ctx->name) == 0) {
        ctx->found = frame;
        return nullptr;
    }
    RwFrameForAllChildren(frame, MissileFindFrameCB, ctx);
    return ctx->found ? nullptr : frame;
}

static RwObject* MissileObjectCB(RwObject* obj, void* data) {
    if (RwObjectGetType(obj) == rpATOMIC) {
        auto* atomic = reinterpret_cast<RpAtomic*>(obj);
        static_cast<AtomicList*>(data)->push_back({ atomic, (unsigned)RpAtomicGetFlags(atomic) });
    }
    return obj;
}

static RwFrame* MissileChildCB(RwFrame* frame, void* data) {
    RwFrameForAllObjects(frame, MissileObjectCB, data);
    RwFrameForAllChildren(frame, MissileChildCB, data);
    return frame;
}

static void CollectMissileAtomics(RwFrame* frame, AtomicList& out) {
    RwFrameForAllObjects(frame, MissileObjectCB, &out);
    RwFrameForAllChildren(frame, MissileChildCB, &out);
}

static CVector MissileLocalPos(RpClump* clump, RwFrame* frame) {
    RwFrame* root = RpClumpGetFrame(clump);
    RwV3d p = RwFrameGetMatrix(frame)->pos;
    for (RwFrame* f = RwFrameGetParent(frame); f && f != root; f = RwFrameGetParent(f))
        RwV3dTransformPoints(&p, &p, 1, RwFrameGetMatrix(f));
    return CVector(p.x, p.y, p.z);
}

static void SetMissileVisible(Missile& m, bool visible) {
    for (auto& a : m.atomics)
        RpAtomicSetFlags(a.first, visible ? a.second : 0);
}

static void ApplyMissileOffset(Missile& m, float offsetY) {
    RwMatrix* mat = RwFrameGetMatrix(m.frame);
    *mat = m.rest;
    mat->pos.y += offsetY;
    RwMatrixUpdate(mat);
    RwFrameUpdateObjects(m.frame);
}

static void ClearMissileTarget(MissileState& st) {
    if (st.pendingTarget) {
        st.pendingTarget->CleanUpOldReference(&st.pendingTarget);
        st.pendingTarget = nullptr;
    }
}

static void BuildMissiles(MissileState& st, RpClump* clump) {
    ClearMissileTarget(st);
    st.clump = clump;
    st.ok = false;
    st.nextPair = 0;
    st.nextSingle = 0;
    st.sinceShot[kOrdnancePrimary] = 1000.0f;
    st.sinceShot[kOrdnanceSecondary] = 1000.0f;
    st.pending = false;
    st.firing = false;
    for (int i = 0; i < 6; i++) {
        Missile& m = st.m[i];
        m = Missile();
        MissileFindCtx ctx = { kMissileNames[i], nullptr };
        RwFrameForAllChildren(RpClumpGetFrame(clump), MissileFindFrameCB, &ctx);
        if (!ctx.found)
            return;
        m.frame = ctx.found;
        m.rest = *RwFrameGetMatrix(ctx.found);
        m.pos = MissileLocalPos(clump, ctx.found);
        CollectMissileAtomics(ctx.found, m.atomics);
    }
    st.ok = true;
}

static bool IsPlaneVmt(CVehicle* v) {
    return *reinterpret_cast<unsigned*>(v) == CPLANE_VMT;
}

static MissileState* GetMissileState(CPlane* veh) {
    RpClump* clump = veh->m_pRwClump;
    if (!clump)
        return nullptr;
    MissileState& st = g_missileStates[veh];
    if (st.clump != clump)
        BuildMissiles(st, clump);
    return st.ok ? &st : nullptr;
}

static float Sq(float x) { return x * x; }

static void UpdateMissile(Missile& m, float dt) {
    switch (m.mode) {
    case MLaunch: {
        m.t += dt;
        ApplyMissileOffset(m, kLaunchDistance * Sq(std::min(m.t / kLaunchSec, 1.0f)));
        break;
    }
    case MHidden: {
        m.t -= dt;
        if (m.t <= 0.0f) {
            SetMissileVisible(m, true);
            if (kReloadSec > 0.0f) {
                m.mode = MReload;
                m.t = 0.0f;
                ApplyMissileOffset(m, -kReloadDistance);
            }
            else {
                m.mode = MRest;
                ApplyMissileOffset(m, 0.0f);
            }
        }
        break;
    }
    case MReload: {
        m.t += dt;
        const float k = std::min(m.t / kReloadSec, 1.0f);
        ApplyMissileOffset(m, -kReloadDistance * Sq(1.0f - k));
        if (k >= 1.0f) {
            m.mode = MRest;
            ApplyMissileOffset(m, 0.0f);
        }
        break;
    }
    default:
        break;
    }
}

static void BeginShot(MissileState& st, int type, CEntity* target) {
    st.sinceShot[type] = 0.0f;
    st.pending = true;
    st.pendingLeft = kLaunchSec;
    st.pendingType = type;
    ClearMissileTarget(st);
    if (target) {
        st.pendingTarget = target;
        target->RegisterReference(&st.pendingTarget);
    }
    if (type == kOrdnanceSecondary) {
        int pick = -1;
        for (int n = 0; n < 6; n++) {
            const int k = (st.nextSingle + n) % 6;
            if (st.m[kSingleOrder[k]].mode == MRest) {
                pick = k;
                break;
            }
        }
        if (pick < 0)
            pick = st.nextSingle;
        st.nextSingle = (pick + 1) % 6;
        st.shotIdx[0] = kSingleOrder[pick];
        st.shotN = 1;
    }
    else {
        st.shotIdx[0] = kPairs[st.nextPair][0];
        st.shotIdx[1] = kPairs[st.nextPair][1];
        st.nextPair = (st.nextPair + 1) % 3;
        st.shotN = 2;
    }
    for (int i = 0; i < st.shotN; i++) {
        Missile& m = st.m[st.shotIdx[i]];
        m.mode = MLaunch;
        m.t = 0.0f;
    }
}

static void FireHoming(CVehicle* veh, const MissileState& st, CEntity* target) {
    const RwV3d& up = veh->m_matrix->up;
    CVector forward(up.x, up.y, up.z);
    const CVector& v = veh->m_vecMoveSpeed;
    float along = v.x * forward.x + v.y * forward.y + v.z * forward.z;
    if (along < 0.0f)
        along = 0.0f;
    const float carry = along * CTimer::ms_fTimeStep;
    for (int i = 0; i < st.shotN; i++) {
        const CVector& p = st.m[st.shotIdx[i]].pos;
        const CVector local(p.x + (p.x >= 0.0f ? kSpawnOffsetX : -kSpawnOffsetX),
            p.y + kLaunchDistance + kSpawnOffsetY,
            p.z + kSpawnOffsetZ);
        CVector world = veh->TransformFromObjectSpace(local);
        world.x += forward.x * carry;
        world.y += forward.y * carry;
        world.z += forward.z * carry;
        CProjectileInfo::AddProjectile(veh, static_cast<eWeaponType>(kProjectileRocketHS), world, 0.0f, &forward, target);
    }
}

static void FireShot(CVehicle* veh, MissileState& st) {
    st.pending = false;
    for (int i = 0; i < st.shotN; i++) {
        Missile& m = st.m[st.shotIdx[i]];
        ApplyMissileOffset(m, 0.0f);
        SetMissileVisible(m, false);
        m.mode = MHidden;
        m.t = kRespawnSec;
    }
    if (st.pendingType == kOrdnanceSecondary) {
        FireHoming(veh, st, st.pendingTarget);
        ClearMissileTarget(st);
    }
    else {
        st.firing = true;
        origFireUnguided(veh, st.pendingType, false);
        st.firing = false;
    }
}

static void UpdateMissileState(CVehicle* veh, MissileState& st, float dt) {
    st.sinceShot[kOrdnancePrimary] += dt;
    st.sinceShot[kOrdnanceSecondary] += dt;
    for (Missile& m : st.m)
        UpdateMissile(m, dt);
    if (st.pending) {
        st.pendingLeft -= dt;
        if (st.pendingLeft <= 0.0f)
            FireShot(veh, st);
    }
}

static void __fastcall FireUnguidedHook(CVehicle* self, void*, int type, bool useRateLimit) {
    if (type == kOrdnancePrimary && IsPlaneVmt(self)) {
        if (MissileState* st = GetMissileState(static_cast<CPlane*>(self))) {
            if (st->pending)
                return;
            if (useRateLimit && st->sinceShot[type] < reinterpret_cast<RateFn>(GET_ORDNANCE_RATE)(self, type) / 1000.0f)
                return;
            BeginShot(*st, type, nullptr);
            return;
        }
    }
    origFireUnguided(self, type, useRateLimit);
}

static void __fastcall FireHeatHook(CVehicle* self, void*, CEntity* target, int type, bool useRateLimit) {
    if (type == kOrdnanceSecondary && IsPlaneVmt(self)) {
        if (MissileState* st = GetMissileState(static_cast<CPlane*>(self))) {
            if (st->pending)
                return;
            if (useRateLimit && st->sinceShot[type] < reinterpret_cast<RateFn>(GET_ORDNANCE_RATE)(self, type) / 1000.0f)
                return;
            BeginShot(*st, type, target);
            return;
        }
    }
    origFireHeat(self, target, type, useRateLimit);
}

static CVector* __fastcall OrdnancePosHook(CVehicle* self, void*, CVector* out, int type) {
    CVector* result = origGetOrdnancePos(self, out, type);
    if (type != kOrdnancePrimary || !IsPlaneVmt(self))
        return result;
    const auto it = g_missileStates.find(self);
    if (it == g_missileStates.end() || !it->second.firing)
        return result;
    const MissileState& st = it->second;
    const CVector& p = st.m[st.shotIdx[0]].pos;
    result->x = std::fabs(p.x) + kSpawnOffsetX;
    result->y = p.y + kLaunchDistance + kSpawnOffsetY;
    result->z = p.z + kSpawnOffsetZ;
    return result;
}

static void RedirectCalls(unsigned target, void* hook) {
    for (unsigned a = 0x401000; a < 0x857000 - 5; ++a) {
        if (*reinterpret_cast<const uint8_t*>(a) != 0xE8)
            continue;
        const int32_t rel = *reinterpret_cast<const int32_t*>(a + 1);
        if (a + 5 + rel == target)
            patch::RedirectCall(a, hook);
    }
}

// =====================================================================
// Combined PreRender
// =====================================================================
static void __fastcall CombinedPreRenderHook(CPlane* self, void*) {
    if (self)
        UpdateGearDoors(self);
    if (self && self->m_pRwObject && self->m_matrix)
        AddGroundRolling(self);
    if (origPreRender)
        origPreRender(self);
    if (self && self->m_pRwObject)
        UpdateHubs(self);
    UpdateExhaust(self);
    if (self && self->m_pRwObject)
        DoPlaneLightsSafe(self);
    if (self)
        UpdateLampTextures(self);
}

// =====================================================================
// Install
// =====================================================================
class PlaneFeatures {
public:
    PlaneFeatures() {
        origPreRender = reinterpret_cast<PlaneFn>(*reinterpret_cast<unsigned*>(PRERENDER_SLOT));
        patch::SetPointer(PRERENDER_SLOT, reinterpret_cast<void*>(&CombinedPreRenderHook));

        origOpenDoor = reinterpret_cast<OpenDoorFn>(*reinterpret_cast<unsigned*>(OPENDOOR_SLOT));
        patch::SetPointer(OPENDOOR_SLOT, reinterpret_cast<void*>(&OpenDoorHook));

        RedirectCalls(FIRE_UNGUIDED, reinterpret_cast<void*>(&FireUnguidedHook));
        RedirectCalls(FIRE_HEAT_SEEKING, reinterpret_cast<void*>(&FireHeatHook));
        RedirectCalls(GET_ORDNANCE_POS, reinterpret_cast<void*>(&OrdnancePosHook));

        Events::vehicleRenderEvent += [](CVehicle* veh) {
            if (!veh || !veh->m_pRwClump)
                return;
            if (veh->m_nVehicleSubClass != VEHICLE_PLANE)
                return;
            auto* plane = static_cast<CPlane*>(veh);
            RwFrame* root = RpClumpGetFrame(veh->m_pRwClump);

            // Extra ailerons
            RwFrame* al = plane->m_aCarNodes[PLANE_AILERON_L];
            RwFrame* ar = plane->m_aCarNodes[PLANE_AILERON_R];
            if (al && ar && root) {
                ExtraAileronState& st = g_aileronStates[veh];
                if (!st.searched) {
                    st.searched = true;
                    st.l2 = FindFrameByName(root, "aileron_l2");
                    st.r2 = FindFrameByName(root, "aileron_r2");
                    st.p2 = FindFrameByName(root, "aileron2_pos");
                }
                if (st.l2 && st.r2 && st.p2) {
                    SaveRest(al, st.restL);
                    SaveRest(ar, st.restR);
                    SaveRest(st.l2, st.restL2);
                    SaveRest(st.r2, st.restR2);
                    SaveRest(st.p2, st.restP2);
                    const RwV3d hingeR = st.restP2.pos;
                    const RwV3d hingeL = { -st.restP2.pos.x, st.restP2.pos.y, st.restP2.pos.z };
                    CopyOrientDelta(al, st.restL, st.l2, st.restL2, hingeL);
                    CopyOrientDelta(ar, st.restR, st.r2, st.restR2, hingeR);
                }
            }

            // Second rudder
            RwFrame* stockRudder = plane->m_aCarNodes[PLANE_RUDDER_NODE];
            if (stockRudder && root) {
                ExtraRudderState& rs = g_rudderStates[veh];
                if (!rs.searched) {
                    rs.searched = true;
                    rs.r2 = FindFrameByName(root, "rudder2");
                    rs.p2 = FindFrameByName(root, "rudder2_pos");
                }
                if (rs.r2 && rs.p2) {
                    SaveRest(stockRudder, rs.restR);
                    SaveRest(rs.r2, rs.restR2);
                    SaveRest(rs.p2, rs.restP2);
                    CopyOrientDelta(stockRudder, rs.restR, rs.r2, rs.restR2, rs.restP2.pos,
                        -1.0f, kRudder2AngleScale);
                }
            }
            };

        Events::vehicleRenderEvent += [](CVehicle* veh) {
            if (!ShouldFixAlphaRef(veh))
                return;
            if (CGame::currArea != 0)
                return;
            void* current = nullptr;
            RwRenderStateGet(rwRENDERSTATEALPHATESTFUNCTIONREF, &current);
            const uintptr_t incoming = reinterpret_cast<uintptr_t>(current);
            if (incoming == kStockEntityRef)
                RwRenderStateSet(rwRENDERSTATEALPHATESTFUNCTIONREF, reinterpret_cast<void*>(kCarRef));
            };

        Events::vehicleRenderEvent += [](CVehicle* veh) {
            UpdateHydraThrusters(veh);
            };

        Events::vehicleRenderEvent += [](CVehicle* veh) {
            UpdateAfterburner(veh);
            };

        Events::gameProcessEvent += [] {
            const float dt = CTimer::ms_fTimeStep / 50.0f;
            for (auto& entry : g_missileStates) {
                if (entry.second.ok)
                    UpdateMissileState(entry.first, entry.second, dt);
            }
            };

        Events::vehicleDtorEvent += [](CVehicle* veh) {
            auto it = g_seen.find(veh);
            if (it != g_seen.end()) {
                const int model = it->second;
                g_seen.erase(it);
                if (--g_liveCount[model] <= 0) {
                    g_liveCount.erase(model);
                    ReleaseModel(model);
                }
            }
            g_aileronStates.erase(veh);
            g_rudderStates.erase(veh);
            g_hubStates.erase(veh);
            g_gearDoors.erase(veh);
            if (veh == g_abBound)
                KillAfterburner();
            OnVehicleDestroyed(veh);

            auto mit = g_missileStates.find(veh);
            if (mit != g_missileStates.end()) {
                ClearMissileTarget(mit->second);
                g_missileStates.erase(mit);
            }
            };
    }
} g_planeFeatures;
