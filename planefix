constexpr int DOOR_BONNET_ID = 0;
constexpr int DOOR_BOOT_ID = 1;
constexpr int NODE_BONNET = 16;
constexpr int NODE_BOOT = 17;

static void __fastcall OpenDoorHook(CPlane* self, void*, CPed* ped, int componentId, int door, float ratio, bool playSound) {
    if (door == DOOR_BONNET_ID || door == DOOR_BOOT_ID) {
        const bool bonnet = (door == DOOR_BONNET_ID);
        const int node = bonnet ? NODE_BONNET : NODE_BOOT;
        RwFrame* frame = nullptr;
        if (self->m_pRwClump)
            frame = FindFrameByName(RpClumpGetFrame(self->m_pRwClump), bonnet ? "bonnet_dummy" : "boot_dummy");
        if (!frame)
            return;
        RwFrame* saved = self->m_aCarNodes[node];
        self->m_aCarNodes[node] = frame;
        origOpenDoor(self, ped, node, door, ratio, playSound);
        self->m_aCarNodes[node] = saved;
        return;
    }
    origOpenDoor(self, ped, componentId, door, ratio, playSound);
}

