static RwFrame* GearFindFrameCB(RwFrame* frame, void* data) {
    auto* ctx = static_cast<GearFindCtx*>(data);
    const char* n = GetFrameNodeName(frame);
    if (n && _stricmp(n, ctx->name) == 0) {
        ctx->found = frame;
        return nullptr;
    }
    RwFrameForAllChildren(frame, GearFindFrameCB, ctx);
    return ctx->found ? nullptr : frame;
}

static void UpdateGearDoors(CPlane* veh) {
    RpClump* clump = veh->m_pRwClump;
    if (!clump)
        return;
    PlaneGearDoors& pd = g_gearDoors[veh];
    if (pd.clump != clump) {
        pd.clump = clump;
        pd.any = false;
        pd.lastApplied = -1.0f;
        for (int i = 0; i < 4; i++) {
            GearFindCtx ctx = { kGearDoors[i].name, nullptr };
            RwFrameForAllChildren(RpClumpGetFrame(clump), GearFindFrameCB, &ctx);
            pd.doors[i].frame = ctx.found;
            if (ctx.found) {
                pd.doors[i].rest = *RwFrameGetMatrix(ctx.found);
                pd.any = true;
            }
        }
    }
    if (!pd.any)
        return;

    const float dt = CTimer::ms_fTimeStep / 50.0f;
    float& gear = GearRef(veh);

    if (!pd.seen) {
        pd.seen = true;
        pd.wasUp = gear >= kGearUpThreshold;
        pd.open = pd.wasUp ? 0.0f : 1.0f;
        pd.closeDelayLeft = 0.0f;
    }

    if (pd.holdLeft > 0.0f) {
        pd.holdLeft -= dt;
        if (pd.holdLeft <= 0.0f) {
            pd.holdLeft = 0.0f;
            gear = pd.heldValue;
        }
        else {
            gear = 1.0f;
        }
    }
    else if (pd.wasUp&& gear < kGearUpThreshold) {
        pd.heldValue = gear;
        pd.holdLeft = kGearHoldSec;
        gear = 1.0f;
    }

    const bool holding = pd.holdLeft > 0.0f;
    const bool gearMostlyUp = gear >= kGearUpThreshold;
    pd.wasUp = gearMostlyUp;

    float target = 1.0f;
    if (holding) {
        pd.closeDelayLeft = kCloseDelaySec;
        target = 1.0f;
    }
    else if (gearMostlyUp) {
        if (kCloseDelaySec <= 0.0f) {
            target = 0.0f;
        }
        else {
            pd.closeDelayLeft -= dt;
            if (pd.closeDelayLeft <= 0.0f)
                target = 0.0f;
        }
    }
    else {
        pd.closeDelayLeft = kCloseDelaySec;
        target = 1.0f;
    }

    const float doorSec = (kDoorSec > 0.001f) ? kDoorSec : 0.001f;
    const float step = dt / doorSec;
    pd.open = pd.open < target ? std::min(target, pd.open + step) : std::max(target, pd.open - step);
    const float eased = pd.open * pd.open * (3.0f - 2.0f * pd.open);

    if (std::fabs(eased - pd.lastApplied) < 0.0001f)
        return;
    pd.lastApplied = eased;

    for (int i = 0; i < 4; i++) {
        RwFrame* frame = pd.doors[i].frame;
        if (!frame)
            continue;
        RwMatrix* m = RwFrameGetMatrix(frame);
        *m = pd.doors[i].rest;
        const RwV3d axis = { kGearDoors[i].axisX, kGearDoors[i].axisY, kGearDoors[i].axisZ };
        RwMatrixRotate(m, &axis, kOpenAngleDeg * kGearDoors[i].sign * eased, rwCOMBINEPRECONCAT);
        RwMatrixUpdate(m);
        RwFrameUpdateObjects(frame);
    }
}

