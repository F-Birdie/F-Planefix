constexpr int      kExhaustDummyIndex = 6;
constexpr float    kHazeIntensity = 0.1f;
constexpr float    kPuffIntensity = 0.9f;
constexpr float    kPuffScale = 0.6f;
constexpr unsigned kPuffMs = 500;
constexpr float    kPuffPitchDeg = 90.0f;

struct Pri0 {};
struct Pri1 : Pri0 {};
struct Pri2 : Pri1 {};

template <class T> auto EngineOnImpl(const T* v, Pri2) -> decltype(bool(v->bEngineOn)) { return v->bEngineOn; }
template <class T> auto EngineOnImpl(const T* v, Pri1) -> decltype(bool(v->vehicleFlags.bEngineOn)) { return v->vehicleFlags.bEngineOn; }
template <class T> bool EngineOnImpl(const T* v, Pri0) { return (*(reinterpret_cast<const uint8_t*>(v) + 0x428) & 0x10) != 0; }
static bool EngineOn(const CVehicle* v) { return EngineOnImpl(v, Pri2{}); }

template <class T> auto DoubleExhaustImpl(const T* v, Pri2) -> decltype(bool(v->m_pHandlingData->m_bDoubleExhaust)) {
    return v->m_pHandlingData->m_bDoubleExhaust;
}
template <class T> auto DoubleExhaustImpl(const T* v, Pri1) -> decltype(bool(v->m_pHandlingData->m_nModelFlags & 0x2000)) {
    return (v->m_pHandlingData->m_nModelFlags & 0x2000) != 0;
}
template <class T> bool DoubleExhaustImpl(const T*, Pri0) { return false; }
static bool DoubleExhaust(const CVehicle* v) { return v->m_pHandlingData && DoubleExhaustImpl(v, Pri2{}); }

struct ExhaustState {
    bool        seen = false;
    bool        engineWasOn = false;
    FxSystem_c* haze[2] = {};
    FxSystem_c* puff[2] = {};
    RwMatrix* puffMat[2] = {};
    DWORD       puffEnd = 0;
};
static std::unordered_map<CVehicle*, ExhaustState> g_exhaustStates;

static void Kill(FxSystem_c*& fx) {
    if (fx) {
        fx->Kill();
        fx = nullptr;
    }
}

static RwMatrix* NextPuffMatrix() {
    static RwMatrix* pool[16] = {};
    static int next = 0;
    RwMatrix*& m = pool[next];
    next = (next + 1) % 16;
    if (!m)
        m = RwMatrixCreate();
    return m;
}

static RwMatrix* RootMatrix(CPlane* veh) {
    return RwFrameGetMatrix(RpClumpGetFrame(veh->m_pRwClump));
}

static void UpdatePuffMatrix(CPlane* veh, RwMatrix* out, const RwV3d& dummy) {
    RwMatrix* root = RootMatrix(veh);
    RwV3d world;
    RwV3dTransformPoints(&world, &dummy, 1, root);
    *out = *root;
    const RwV3d xAxis = { 1.0f, 0.0f, 0.0f };
    RwMatrixRotate(out, &xAxis, kPuffPitchDeg, rwCOMBINEPRECONCAT);
    for (RwV3d* axis : { &out->right, &out->up, &out->at }) {
        axis->x *= kPuffScale;
        axis->y *= kPuffScale;
        axis->z *= kPuffScale;
    }
    out->pos = world;
    RwMatrixUpdate(out);
}

static FxSystem_c* CreateHaze(CPlane* veh, const RwV3d& dummy) {
    RwV3d pos = dummy;
    FxSystem_c* fx = g_fxMan.CreateFxSystem(const_cast<char*>("nitro"), &pos, RootMatrix(veh), true);
    if (!fx)
        return nullptr;
    fx->SetLocalParticles(true);
    fx->Play();
    fx->EnablePrim(0, true);
    fx->EnablePrim(1, false);
    fx->EnablePrim(2, false);
    fx->EnablePrim(3, false);
    return fx;
}

static void StartPuff(CPlane* veh, ExhaustState& s, int i, const RwV3d& dummy) {
    Kill(s.puff[i]);
    s.puffMat[i] = NextPuffMatrix();
    UpdatePuffMatrix(veh, s.puffMat[i], dummy);
    RwV3d zero = { 0.0f, 0.0f, 0.0f };
    s.puff[i] = g_fxMan.CreateFxSystem(const_cast<char*>("overheat_car"), &zero, s.puffMat[i], false);
    if (!s.puff[i])
        return;
    s.puff[i]->SetConstTime(1, kPuffIntensity);
    s.puff[i]->Play();
}

static void UpdateExhaust(CPlane* veh) {
    if (!veh->m_pRwClump)
        return;
    auto* mi = static_cast<CVehicleModelInfo*>(CModelInfo::GetModelInfo(veh->m_nModelIndex));
    if (!mi || !mi->m_pVehicleStruct)
        return;
    const CVector& d = mi->m_pVehicleStruct->m_avDummyPos[kExhaustDummyIndex];
    if (d.x == 0.0f && d.y == 0.0f && d.z == 0.0f)
        return;

    const RwV3d dummies[2] = { { d.x, d.y, d.z }, { -d.x, d.y, d.z } };
    const int   count = DoubleExhaust(veh) ? 2 : 1;

    ExhaustState& s = g_exhaustStates[veh];
    const bool on = EngineOn(veh);
    if (!s.seen) {
        s.seen = true;
        s.engineWasOn = on;
    }
    if (on && !s.engineWasOn) {
        for (int i = 0; i < count; i++)
            StartPuff(veh, s, i, dummies[i]);
        s.puffEnd = GetTickCount() + kPuffMs;
    }
    s.engineWasOn = on;

    for (int i = 0; i < 2; i++) {
        if (on && i < count) {
            if (!s.haze[i])
                s.haze[i] = CreateHaze(veh, dummies[i]);
            if (s.haze[i])
                s.haze[i]->SetConstTime(1, kHazeIntensity);
        }
        else {
            Kill(s.haze[i]);
        }

        if (s.puff[i]) {
            if (GetTickCount() >= s.puffEnd) {
                Kill(s.puff[i]);
            }
            else {
                UpdatePuffMatrix(veh, s.puffMat[i], dummies[i]);
                s.puff[i]->SetConstTime(1, kPuffIntensity);
            }
        }
    }
}

static void OnVehicleDestroyed(CVehicle* veh) {
    auto it = g_exhaustStates.find(veh);
    if (it == g_exhaustStates.end())
        return;
    for (int i = 0; i < 2; i++) {
        Kill(it->second.haze[i]);
        Kill(it->second.puff[i]);
    }
    g_exhaustStates.erase(it);
}

