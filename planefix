// 6) Rolling wheels + hubs
// =====================================================================
struct HubState {
    bool searched = false;
    RwFrame* hub[4] = {};
    RwFrame* wheel[4] = {};
};
static std::unordered_map<CVehicle*, HubState> g_hubStates;

static const int   kWheelNode[4] = { 5, 7, 2, 4 };
static const float kSpinSign[4] = { 1.0f, 1.0f, -1.0f, -1.0f };

static void AddGroundRolling(CPlane* self) {
    auto* mi = static_cast<CVehicleModelInfo*>(CModelInfo::GetModelInfo(self->m_nModelIndex));
    if (!mi || !self->m_matrix)
        return;
    const CVector forward = self->m_matrix->up;
    for (int i = 0; i < 4; i++) {
        if (self->m_fWheelCounts[i] <= 0.0f)
            continue;
        const float size = (i == 0 || i == 2) ? mi->m_fWheelSizeFront : mi->m_fWheelSizeRear;
        const float radius = size * 0.5f;
        if (radius <= 0.0f)
            continue;
        self->m_fWheelRotation[i] += CTimer::ms_fTimeStep *
            self->ProcessWheelRotation((tWheelState)self->m_wheelState[i], forward, self->m_vecMoveSpeed, radius);
    }
}

static void UpdateHubs(CPlane* self) {
    if (!self->m_pRwClump)
        return;
    HubState& st = g_hubStates[self];
    if (!st.searched) {
        st.searched = true;
        RwFrame* root = RpClumpGetFrame(self->m_pRwClump);
        if (root) {
            st.hub[0] = FindFrameByName(root, "hub_lf");
            st.hub[1] = FindFrameByName(root, "hub_lb");
            st.hub[2] = FindFrameByName(root, "hub_rf");
            st.hub[3] = FindFrameByName(root, "hub_rb");
        }
        for (int i = 0; i < 4; i++)
            st.wheel[i] = self->m_aCarNodes[kWheelNode[i]];
    }
    for (int i = 0; i < 4; i++) {
        RwFrame* hub = st.hub[i];
        RwFrame* wheel = st.wheel[i];
        if (!hub || !wheel)
            continue;
        RwMatrix* hm = RwFrameGetMatrix(hub);
        RwMatrix* wm = RwFrameGetMatrix(wheel);
        if (!hm || !wm)
            continue;
        hm->right = wm->right;
        hm->up = wm->up;
        hm->at = wm->at;
        hm->pos = wm->pos;
        const float deg = kSpinSign[i] * self->m_fWheelRotation[i] * RAD2DEG;
        const RwV3d xAxis = { 1.0f, 0.0f, 0.0f };
        RwMatrixRotate(hm, &xAxis, deg, rwCOMBINEPRECONCAT);
        RwMatrixUpdate(hm);
        RwFrameUpdateObjects(hub);
    }
}

